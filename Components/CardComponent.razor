<div class="card @(IsSelected ? "card-selected" : "") @(IsHighlighted ? "card-highlighted" : "") @(IsNewlyDrawn ? "card-newly-drawn" : "") @(card.IsRed ? "card-red" : "card-black")"
     data-card-id="@card.Id"
     draggable="@(CanDrag ? "true" : "false")"
     @onclick="HandleClick">
    @if (card.IsJoker)
    {
        <span class="card-joker-center">🃏</span>
    }
    else
    {
        <div class="card-corner card-corner-top">
            <span class="card-corner-rank">@card.RankSymbol</span>
            <span class="card-corner-suit">@card.SuitSymbol</span>
        </div>
        <span class="card-center-suit" aria-hidden="true">@card.SuitSymbol</span>
        <div class="card-corner card-corner-bottom">
            <span class="card-corner-rank">@card.RankSymbol</span>
            <span class="card-corner-suit">@card.SuitSymbol</span>
        </div>
    }
</div>

@code {
    [Parameter] public Card card { get; set; } = null!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsHighlighted { get; set; }
    [Parameter] public bool IsNewlyDrawn { get; set; }
    [Parameter] public bool CanDrag { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task HandleClick()
    {
        await OnClick.InvokeAsync();
    }
}
