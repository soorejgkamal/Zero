@page "/game"

<div class="game-container">
    @if (CurrentState == null)
    {
        <div class="loading">
            <div class="loading-spinner"></div>
            <span>Loading game...</span>
        </div>
    }
    else
    {
        <div class="game-header">
            <div class="game-info">
                <span>Room: @CurrentState.RoomId</span>
                <span>Deck: @CurrentState.DeckCount cards</span>
                @if (CurrentState.Phase == GamePhase.Playing)
                {
                    <span class="turn-indicator">
                        @if (IsMyTurn)
                        {
                            <strong>YOUR TURN</strong>
                            <span class="turn-hint"> — Choose an action</span>
                        }
                        else
                        {
                            <text>@GetCurrentPlayerName()'s turn</text>
                        }
                    </span>
                }
                <button class="scoreboard-btn" @onclick="ToggleScoreboard" title="View scores">
                    🏆 Scores
                </button>
                <VoiceChatComponent />
            </div>
        </div>

        @if (ShowScoreboard)
        {
            <div class="scoreboard-popup-overlay" @onclick="ToggleScoreboard">
                <div class="scoreboard-popup" @onclick:stopPropagation="true">
                    <div class="scoreboard-popup-header">
                        <h3>🏆 Scoreboard</h3>
                        <button class="close-btn" @onclick="ToggleScoreboard">✕</button>
                    </div>
                    <ScoreBoardComponent Players="@CurrentState.Players" CurrentPlayerId="@CurrentState.CurrentPlayerId" />
                    <p class="scoreboard-note">First to reach 100 points is eliminated.</p>
                </div>
            </div>
        }

        @if (ShowTurnBanner)
        {
            <div class="turn-banner">✨ Your Turn!</div>
        }

        <div class="opponents-area">
            @foreach (var player in CurrentState.Players.Where(p => p.Id != GameService.PlayerId))
            {
                var visibleCards = Math.Min(player.CardCount, 4);
                <div class="opponent @(player.Id == CurrentState.CurrentPlayerId ? "current-turn" : "") @(player.IsEliminated ? "eliminated" : "")">
                    <div class="card-back-stack">
                        @if (player.CardCount == 0)
                        {
                            <span class="no-cards-text">—</span>
                        }
                        else
                        {
                            @for (var i = 0; i < visibleCards; i++)
                            {
                                var offset = i * 6;
                                <div class="card-back-mini" style="left: @(offset)px; z-index: @(i);"></div>
                            }
                        }
                    </div>
                    <div class="opponent-name">@player.Name @(!player.IsConnected ? "(DC)" : "")</div>
                    <div class="opponent-info">@player.CardCount cards · @player.Score pts</div>
                </div>
            }
        </div>

        <div class="table-area" id="table-drop-zone">
            <h3 class="table-area-heading">Table Sets</h3>
            <div class="table-sets">
                @if (CurrentState.TableSets.Any())
                {
                    @foreach (var seq in CurrentState.TableSets)
                    {
                        var placedByName = CurrentState.Players.FirstOrDefault(p => p.Id == seq.PlacedByPlayerId)?.Name ?? "Unknown";
                        var myPlayer = CurrentState.Players.FirstOrDefault(p => p.Id == GameService.PlayerId);
                        var hasOpened = myPlayer?.HasOpenedSet ?? false;
                        var canAddLeft = IsMyTurn && hasOpened && SelectedCards.Count >= 1 && CanAddCardsToSequence(seq, true);
                        var canAddRight = IsMyTurn && hasOpened && SelectedCards.Count >= 1 && CanAddCardsToSequence(seq, false);
                        
                        <TableSetComponent 
                            Sequence="@seq" 
                            PlacedByName="@placedByName"
                            AllowAddToLeft="@canAddLeft"
                            AllowAddToRight="@canAddRight"
                            OnAddLeft="@(() => AddToSequence(seq.Id, true))"
                            OnAddRight="@(() => AddToSequence(seq.Id, false))" />
                    }
                }
                else
                {
                    <p class="no-sets">No sets on table yet</p>
                }
            </div>
        </div>

        @if (CurrentState.Phase == GamePhase.RoundEnd || CurrentState.Phase == GamePhase.GameOver)
        {
            <div class="round-end-overlay">
                @for (var ci = 0; ci < 18; ci++)
                {
                    var leftPct = (int)(ci * 5.5 + 2);
                    var delayMs = ci * 110;
                    var durationMs = 2200 + (ci % 5) * 350;
                    var confettiColor = GetConfettiColor(ci);
                    <div class="confetti-piece" style="left: @(leftPct)%; animation-delay: @(delayMs)ms; animation-duration: @(durationMs)ms; background: @confettiColor;"></div>
                }
                <div class="round-end">
                    <div class="winner-announcement">
                        <span class="winner-trophy">@(CurrentState.Phase == GamePhase.GameOver ? "🏆" : "🎉")</span>
                        <h2 class="winner-name">@GetPlayerName(CurrentState.WinnerId)</h2>
                        <p class="winner-subtitle">@(CurrentState.Phase == GamePhase.GameOver ? "wins the game!" : "wins the round!")</p>
                    </div>

                    <ScoreBoardComponent Players="@CurrentState.Players" CurrentPlayerId="@CurrentState.CurrentPlayerId" ShowRanks="true" />

                    <div class="round-end-action">
                        @if (CurrentState.Phase == GamePhase.GameOver)
                        {
                            <button @onclick="BackToLobby" class="btn btn-primary">Back to Lobby</button>
                        }
                        else
                        {
                            <button @onclick="StartNewRound" class="btn btn-primary">Start New Round</button>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="player-area">
            @if (CurrentState.Phase == GamePhase.Playing)
            {
                <div class="player-actions">
                    <button @onclick="DiscardAndDraw" class="btn btn-primary"
                            disabled="@(!CanDiscard)"
                            title="@(!IsMyTurn ? "Wait for your turn" : "Select exactly 1 card to discard and draw")">
                        Discard &amp; Draw
                    </button>
                    <button @onclick="OpenSet" class="btn btn-success"
                            disabled="@(!CanOpenSet)"
                            title="@(!IsMyTurn ? "Wait for your turn" : "Select 3 or more cards to open a set")">
                        Open Set @(SelectedCards.Count >= 3 ? $"({SelectedCards.Count})" : "")
                    </button>
                    <button @onclick="ClearSelection" class="btn btn-secondary"
                            disabled="@(SelectedCards.Count == 0)"
                            title="Deselect all cards">
                        Clear
                    </button>
                </div>
                <p class="action-hint">@ActionHint</p>
            }

            <HandComponent
                Cards="@MyHand"
                SelectedCardIds="@SelectedCards"
                NewlyDrawnCardId="@CurrentState.NewlyDrawnCardId"
                CanDrag="@(IsMyTurn && CurrentState?.Phase == GamePhase.Playing)"
                OnCardSelected="@HandleCardSelected" />
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="error-toast">
                <span class="toast-icon">⚠️</span>
                <span class="toast-message">@ErrorMessage</span>
                <button class="toast-close" @onclick="DismissError">✕</button>
                <div class="toast-progress"></div>
            </div>
        }
    }
</div>

@code {
    [Inject] private GameService GameService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private GameStateDto? CurrentState;
    private List<string> SelectedCards = new();
    private string? ErrorMessage;
    private bool ShowScoreboard = false;
    private bool ShowTurnBanner = false;
    private bool _wasMyTurn = false;
    private DotNetObjectReference<Game>? _dragRef;

    private bool IsMyTurn => CurrentState?.CurrentPlayerId == GameService.PlayerId;
    private bool CanDiscard => IsMyTurn && CurrentState?.Phase == GamePhase.Playing && SelectedCards.Count == 1;
    private bool CanOpenSet => IsMyTurn && CurrentState?.Phase == GamePhase.Playing && SelectedCards.Count >= 3;

    private string ActionHint
    {
        get
        {
            if (CurrentState?.Phase != GamePhase.Playing) return "";
            if (!IsMyTurn) return "Waiting for your turn...";
            if (SelectedCards.Count == 0) return "Select a card to begin";
            if (SelectedCards.Count == 1) return "Discard & draw, or select more cards to open a set";
            if (SelectedCards.Count == 2) return "Select 1 more card to open a set";
            return $"{SelectedCards.Count} cards selected — open a set or extend a table set";
        }
    }
    private List<Card> MyHand => CurrentState?.Players.FirstOrDefault(p => p.Id == GameService.PlayerId)?.Hand ?? new List<Card>();

    protected override async Task OnInitializedAsync()
    {
        if (!GameService.IsConnected)
        {
            Navigation.NavigateTo("/");
            return;
        }

        GameService.OnGameStateUpdated += HandleGameStateUpdated;
        GameService.OnError += HandleError;
        GameService.OnRoundEnded += HandleRoundEnded;

        // Use cached game state if available (handles race condition where state arrives before subscription)
        if (GameService.CurrentGameState != null)
        {
            CurrentState = GameService.CurrentGameState;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dragRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("cardDragDrop.init", _dragRef);
        }
    }

    [JSInvokable]
    public async Task OnCardDroppedToDiscard(string cardId)
    {
        if (!IsMyTurn || CurrentState?.Phase != GamePhase.Playing) return;
        ErrorMessage = null;
        await GameService.DiscardAndDrawAsync(cardId);
        SelectedCards.Remove(cardId);
        await InvokeAsync(StateHasChanged);
    }

    private void HandleGameStateUpdated(GameStateDto state)
    {
        CurrentState = state;

        if (state.Phase == GamePhase.Lobby)
        {
            Navigation.NavigateTo("/");
        }

        var isMyTurnNow = state.CurrentPlayerId == GameService.PlayerId && state.Phase == GamePhase.Playing;
        if (isMyTurnNow && !_wasMyTurn)
        {
            _ = ShowTurnBannerAsync();
        }
        _wasMyTurn = isMyTurnNow;

        InvokeAsync(StateHasChanged);
    }

    private async Task ShowTurnBannerAsync()
    {
        ShowTurnBanner = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2800);
        ShowTurnBanner = false;
        await InvokeAsync(StateHasChanged);
    }

    private void HandleError(string message)
    {
        ErrorMessage = message;
        InvokeAsync(StateHasChanged);

        Task.Run(async () =>
        {
            await Task.Delay(3000);
            ErrorMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void DismissError()
    {
        ErrorMessage = null;
    }

    private static string GetConfettiColor(int i) => (i % 7) switch
    {
        0 => "#FFD700",
        1 => "#FF5252",
        2 => "#69F0AE",
        3 => "#40C4FF",
        4 => "#FF4081",
        5 => "#FFAB40",
        _ => "#E040FB"
    };

    private void HandleRoundEnded(string winnerId)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task DiscardAndDraw()
    {
        if (SelectedCards.Count != 1) return;

        ErrorMessage = null;
        await GameService.DiscardAndDrawAsync(SelectedCards[0]);
        SelectedCards.Clear();
    }

    private async Task OpenSet()
    {
        if (SelectedCards.Count < 3) return;
        
        ErrorMessage = null;
        await GameService.OpenSetAsync(SelectedCards);
        SelectedCards.Clear();
    }

    private async Task AddToSequence(string sequenceId, bool addToLeft)
    {
        if (SelectedCards.Count == 0) return;
        
        ErrorMessage = null;
        await GameService.AddToSetAsync(sequenceId, SelectedCards.ToList(), addToLeft);
        SelectedCards.Clear();
    }

    private void HandleCardSelected(string cardId)
    {
        if (SelectedCards.Contains(cardId))
        {
            SelectedCards.Remove(cardId);
        }
        else
        {
            SelectedCards.Add(cardId);
        }
        StateHasChanged();
    }

    private void ToggleScoreboard()
    {
        ShowScoreboard = !ShowScoreboard;
    }

    private void ClearSelection()
    {
        SelectedCards.Clear();
    }

    private bool CanAddCardsToSequence(Sequence seq, bool toLeft)
    {
        if (SelectedCards.Count == 0) return false;
        var cards = SelectedCards
            .Select(id => MyHand.FirstOrDefault(c => c.Id == id))
            .Where(c => c != null)
            .Cast<Card>()
            .ToList();
        if (cards.Count != SelectedCards.Count) return false;

        return toLeft
            ? GameEngine.CanAddMultipleToLeft(seq, cards)
            : GameEngine.CanAddMultipleToRight(seq, cards);
    }

    private string GetCurrentPlayerName()
    {
        return CurrentState?.Players.FirstOrDefault(p => p.Id == CurrentState.CurrentPlayerId)?.Name ?? "";
    }

    private string GetPlayerName(string? playerId)
    {
        if (string.IsNullOrEmpty(playerId)) return "";
        return CurrentState?.Players.FirstOrDefault(p => p.Id == playerId)?.Name ?? "";
    }

    private async Task StartNewRound()
    {
        if (CurrentState?.RoomId != null)
        {
            await GameService.StartGameAsync(CurrentState.RoomId);
        }
    }

    private void BackToLobby()
    {
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        GameService.OnGameStateUpdated -= HandleGameStateUpdated;
        GameService.OnError -= HandleError;
        GameService.OnRoundEnded -= HandleRoundEnded;
        _dragRef?.Dispose();
    }
}
